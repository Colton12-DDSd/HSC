{
  "name": "hearthstone-commander",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "import:cards": "node scripts/import-cards.mjs",
    "audit:minions": "node scripts/audit-minion-coverage.mjs",
    "audit:foundation": "npm run audit:minions && node scripts/report-foundation-battlecries.mjs",
    "audit:battlecries": "npm run audit:minions && node scripts/report-battlecries.mjs",
    "group:battlecries": "npm run audit:minions && node scripts/group-battlecries.mjs",
    "test:battlecry-groups": "node --test scripts/battlecry-groups.test.mjs",
    "compile:battlecries": "python scripts/compile-battlecries.py",
    "test:compiler": "python scripts/test_compile_battlecries.py"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.4",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@types/node": "22.18.6",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.3",
    "prettier": "3.6.2",
    "supabase": "2.121.0",
    "typescript": "5.9.2",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
